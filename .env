NODE_ENV=production
PORT=3000
# Rate limit: máximo de requisições por IP na janela (ms)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
# Atrás de nginx/proxy reverso: 1
TRUST_PROXY=1
# Origens do frontend (separadas por vírgula)
CORS_ORIGINS=<URL_DO_FRONTEND>
# Opcional
REDIS_URL=
TSE_BASE_URL=https://resultados-sim.tse.jus.br/simulado
TSE_ENV=simulado2026
TSE_CYCLE=ele2026
TSE_TARGET_DATE=2026-10-04
TSE_POLL_INTERVAL_MS=30000
TSE_REQUEST_TIMEOUT_MS=10000
TSE_MAX_RETRIES=3
# MySQL do contador de acessos (formato: mysql://usuario:senha@host:3306/banco)
DATABASE_URL="mysql://apura:FP6yADAHQQARPCb2@209.50.229.141:3306/apura"
